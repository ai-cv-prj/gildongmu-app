# 기본 주소·포트는 configs/app.yaml에서 관리한다.
# 아래 값은 이 PC의 실행 스크립트에서 YAML 설정보다 우선한다.
APP_HOST=127.0.0.1
APP_PORT=8001

# 고정 HTTPS 주소를 쓰려면 아래 두 값을 모두 설정한다. 둘 다 비우면 임시 주소를 사용한다.
# 토큰 자체를 .env에 넣지 말고, 권한 600의 로컬 파일에 저장한다.
# CLOUDFLARE_TUNNEL_TOKEN_FILE=.local-only/cloudflare/app-token
# CLOUDFLARE_TUNNEL_URL=https://app.example.com

# 서울시 버스 도착정보 API 키. 직접 uvicorn을 실행할 때도 이 파일에서 읽는다.
# 키를 변경한 뒤에는 서버를 재시작한다.
SEOUL_BUS_API_KEY=
