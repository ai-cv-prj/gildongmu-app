# Reference only. Generate a private .env.hub with:
# python -m scripts.init_hub_env
# Docker Compose reads .env.hub; do not source it in a shell.
HUB_PORT=8080
HUB_UID=1000
HUB_GID=1000
HUB_VIEWER_USERNAME=team
HUB_VIEWER_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS
# Optional for existing installs; add privately with python -m scripts.init_hub_admin.
# Must differ from the viewer password and every source token. Never share with viewers.
HUB_ADMIN_PASSWORD=REPLACE_WITH_A_DISTINCT_RANDOM_PASSWORD_AT_LEAST_32_CHARACTERS
HUB_SOURCE_TOKENS_JSON='{"member1":"REPLACE_WITH_MEMBER1_RANDOM_TOKEN","member2":"REPLACE_WITH_MEMBER2_RANDOM_TOKEN","member3":"REPLACE_WITH_MEMBER3_RANDOM_TOKEN","member4":"REPLACE_WITH_MEMBER4_RANDOM_TOKEN"}'
